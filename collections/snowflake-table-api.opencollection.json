          "docs": "Fetch a Table using the describe command output."
        },
        {
          "info": {
            "name": "Create a (or Alter an Existing) Table.",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://org-account.snowflakecomputing.com/api/v2/databases/:database/schemas/:schema/tables/:name",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a (or alter an existing) table. Even if the operation is just an alter, the full property set must be provided."
        },
        {
          "info": {
            "name": "Delete a Table",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://org-account.snowflakecomputing.com/api/v2/databases/:database/schemas/:schema/tables/:name"
