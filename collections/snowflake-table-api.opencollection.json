            "method": "POST",
            "url": "https://org-account.snowflakecomputing.com/api/v2/databases/:database/schemas/:schema/tables/:name:using_template",
            "params": [
              {
                "name": "query",
                "value": "example_value",
                "type": "query",
                "description": "The SQL query that uses INFER_SCHEMA on staged files to set the column definitions for the new table."
              }
            ]
          },
          "docs": "Create a table using template."
