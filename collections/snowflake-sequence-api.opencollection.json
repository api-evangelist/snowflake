            "params": [
              {
                "name": "targetDatabase",
                "value": "",
                "type": "query",
                "description": "Database of the target resource. Defaults to the source's database"
              },
              {
                "name": "targetSchema",
                "value": "",
                "type": "query",
                "description": "Schema of the target resource. Defaults to the source's schema"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a new sequence by cloning from the specified resource"
        },
        {
          "info": {
